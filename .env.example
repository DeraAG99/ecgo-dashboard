# ==== Dev (Next.js) — disalin ke .env.local ====
# PostgreSQL lokal di port 5432. Credential ini khusus dev, bukan secret.
DATABASE_URL=postgresql://postgres:password@localhost:5432/ecgo_dashboard
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==== Deploy VM (docker-compose) — disalin ke .env di root ====
# Wajib diisi dengan password yang kuat. JANGAN commit nilai asli.
# DATABASE_URL memakai host internal "postgres" (nama service compose).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ecgo_dashboard
DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres:5432/ecgo_dashboard
